worker_processes auto;

events {
    worker_connections 2048;
    multi_accept on;
    use epoll;
}

http {
  etag off;

  include mime.types;
  default_type application/octet-stream;

  client_header_timeout  15m;
  client_body_timeout    15m;
  send_timeout           15m;

  # Keep connections alive
  keepalive_timeout      75s;

  server {
    listen ${PORT};
    client_max_body_size 1M;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api_mlflow {
      proxy_pass ${MLFLOW_SERVICE_URL};
      add_header 'Access-Control-Allow-Origin' "$http_origin" always;
      add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
      add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
      add_header 'Access-Control-Allow-Credentials' 'true' always;
      add_header X-Proxied-By "nginx-department" always;

      if ($request_method = OPTIONS) {
        return 204;
      }

      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api_institute {
      proxy_pass ${INSTITUTE_SERVICE_URL};
      add_header 'Access-Control-Allow-Origin' "$http_origin" always;
      add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
      add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
      add_header 'Access-Control-Allow-Credentials' 'true' always;
      add_header X-Proxied-By "nginx-department" always;

      if ($request_method = OPTIONS) {
        return 204;
      }

      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api_federated_learning_management {
      proxy_pass ${FEDERATED_LEARNING_MANAGEMENT_SERVICE_URL};
      add_header 'Access-Control-Allow-Origin' "$http_origin" always;
      add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
      add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;
      add_header 'Access-Control-Allow-Credentials' 'true' always;
      add_header X-Proxied-By "nginx-department" always;

      if ($request_method = OPTIONS) {
        return 204;
      }

      proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^/api_federated_learning_management/.*/sse(/.*)?$ {
      proxy_pass ${FEDERATED_LEARNING_MANAGEMENT_SERVICE_URL};

      proxy_set_header Connection "";
      proxy_http_version 1.1;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      proxy_buffering off;
      proxy_cache off;
      proxy_no_cache 1;
      proxy_cache_bypass 1;

      add_header Cache-Control "no-cache, no-store, must-revalidate";
      add_header Pragma "no-cache";
      add_header Expires "0";

      add_header 'Access-Control-Allow-Origin' "$http_origin" always;
      add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
      add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type, Cache-Control' always;
      add_header 'Access-Control-Allow-Credentials' 'true' always;
      add_header X-Proxied-By "nginx-frontend" always;
      add_header X-Accel-Buffering no;

      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_connect_timeout 60s;

      if ($request_method = OPTIONS) {
        return 204;
      }
    }
  }
}